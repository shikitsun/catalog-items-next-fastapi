POSTGRES_USER = postgres
POSTGRES_DB = postgres_test
# minio
MINIO_ROOT_USER = minioadmin
# minio
MINIO_ROOT_PASSWORD = example12
# url to database, used in backend service
DATABASE_URL = "postgresql+asyncpg://postgres:example@db:5432/postgres_test"
# access key for s3, copy of minio_root_user
S3_ROOT_USER = "minioadmin"
# secret key for s3, copy of minio_root_password
S3_ROOT_PASSWORD = "example12"
# url to s3
S3_URL = "http://minio:9000"
# bucket name in s3
S3_BUCKET_NAME = "test_bucket"
# telegram ids for bot,  list separated by ,
BOT_ADMIN_IDS=123,321
# backend api
API_URL = http://localhost:9091
# Token for protected endpoints (create, update and maybe futher similar)
INTERNAL_TOKEN = "__token__"
# api url of bot verification microservice for backend
BOT_API_URL = http://bot:62402
# Port for web bot (verification)
BOT_WEB_APP_PORT = 62402
# telegram webhook configuration. If missing fallbacks to default polling
WEBHOOK_BASE = 
WEBHOOK_PATH = /webhook
